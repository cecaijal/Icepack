#!/bin/csh -f

setenv ICE_MACHINE_MACHNAME ubuntu
setenv ICE_MACHINE_MACHINFO "Undefined"
setenv ICE_MACHINE_ENVNAME gnu
setenv ICE_MACHINE_ENVINFO "Undefined"
setenv ICE_MACHINE_MAKE gmake
setenv ICE_MACHINE_WKDIR ~/data/post_doc/Icepack_modelling/Icepack_rundir
setenv ICE_MACHINE_INPUTDATA ~/data/post_doc/Icepack_modelling/Icepack_input_data
setenv ICE_MACHINE_BASELINE ~/data/post_doc/Icepack_modelling/Icepack_install
setenv ICE_MACHINE_SUBMIT "csh"
setenv ICE_MACHINE_TPNODE 4
setenv ICE_MACHINE_QUEUE "default"
setenv ICE_MACHINE_ACCT "none"
setenv ICE_MACHINE_BLDTHRDS 1
setenv ICE_MACHINE_QSTAT ""
